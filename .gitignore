/target
*.log
/dist

# Test screenshots / snapshots never belong in git (write them to %TEMP% instead).
/screenshots/
/shots/
**/shots/
/scratch/
/test-output/
snap*.png
*screenshot*.png
*_snapshot*.png

# ...except the curated README/docs media, generated by scripts/update-readme-media.ps1.
# This is the only place product screenshots and videos are tracked.
!docs/media/
!docs/media/**
